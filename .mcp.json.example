{
  "mcpServers": {
    "pg-docker": {
      "command": "node",
      "args": ["./tools/mcp-pg-server/dist/index.js"],
      "env": {
        "DATABASE_URL": "postgresql://postgres:YOUR_PASSWORD@localhost:5432/secondbrain?sslmode=disable"
      }
    },
    "pg-tauri": {
      "command": "node",
      "args": ["./tools/mcp-pg-server/dist/index.js"],
      "env": {
        "DATABASE_URL": "postgresql://postgres:YOUR_PASSWORD@localhost:5433/secondbrain?sslmode=disable"
      }
    },
    "second-brain-notes": {
      "command": "node",
      "args": ["./tools/mcp-notes-server/dist/index.js"],
      "env": {
        "SECOND_BRAIN_API_URL": "http://localhost:5001/api",
        "SECOND_BRAIN_API_KEY": "YOUR_API_KEY_HERE"
      }
    }
  }
}
